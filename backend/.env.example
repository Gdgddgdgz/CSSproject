# ── SecureAuth Backend Environment Variables ────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to version control.

# ── Gmail SMTP ────────────────────────────────────────────────────────────────
# Your Gmail address used as the sender
SMTP_EMAIL=your_gmail_address@gmail.com

# A Gmail App Password (NOT your normal Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on the account first.
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./secureauth.db

# ── OTP Settings ─────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=2
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# ── Session Settings ──────────────────────────────────────────────────────────
SESSION_EXPIRE_HOURS=8

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

